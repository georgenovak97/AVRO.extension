<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Справка" Height="860" Width="1296" MinHeight="600" MinWidth="900" WindowState="Maximized" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" FontFamily="Segoe UI" FontSize="12" Background="{DynamicResource BgWindow}">
