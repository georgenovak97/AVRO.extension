    <Style x:Key="TreeExpander" TargetType="ToggleButton"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="19"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="{DynamicResource BgSidebar}"/><Setter Property="BorderBrush" Value="{DynamicResource TreeIcon}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><Grid><Line x:Name="PlusVertical" X1="5" Y1="2" X2="5" Y2="8" Stroke="{DynamicResource TreeIcon}" StrokeThickness="1"/><Line X1="2" Y1="5" X2="8" Y2="5" Stroke="{DynamicResource TreeIcon}" StrokeThickness="1"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="PlusVertical" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
