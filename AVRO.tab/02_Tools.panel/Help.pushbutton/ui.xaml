nd="{DynamicResource BgToolbar}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="0,0,0,1" Padding="9,6"><Grid VerticalAlignment="Center"><TextBox x:Name="SearchBox" Padding="6,4,30,4" Height="27" VerticalContentAlignment="Center"/><TextBlock x:Name="SearchHint" Text="Поиск по документам" IsHitTestVisible="False" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextMuted}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button x:Name="BtnClearSearch" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Width="24" Height="24" Margin="0,0,4,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ClearSearchButton}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid></Border><WebBrowser x:Name="MarkdownBrowser" Grid.Row="2"/></Grid><GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="{DynamicResource BorderLight}"/><Border Grid.Column="4" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderMain}" BorderThickness="1,0,0,0"><Border Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderMain}" BorderThickness="0"><DockPanel LastChildFill="True"><Border DockPanel.Dock="Top" Background="{DynamicResource BgToolbar}" BorderBrush="{DynamicResource BorderLight}" BorderThickness="0,0,0,1" Padding="9,7"><TextBlock x:Name="TocTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/></Border><ListBox x:Name="TocTree" Margin="0"/></DockPanel></Border></Border></Grid><Border Grid.Row="1" Background="{DynamicResource BgToolbar}" BorderBrush="{DynamicResource BorderMain}" BorderThickness="0,1,0,0" Padding="10,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="StatusText" Grid.Column="1" Text="Готово" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMain}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Cursor="IBeam" FocusVisualStyle="{x:Null}" MaxWidth="600"/><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BtnDocuments" Style="{StaticResource RevitButton}"/><Button x:Name="BtnRefresh" Style="{StaticResource RevitButton}" Margin="6,0,0,0"/></StackPanel></Grid></Border></Grid>
